# Настройки HTTP-сервера
PORT=8080

# Настройки PostgreSQL для docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=secure_service
POSTGRES_PORT=55432

# Строка подключения приложения к PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:55432/secure_service?sslmode=disable

# Обязательно замените значение. Секрет должен содержать не менее 32 символов.
JWT_SECRET=change-this-demo-secret-to-a-long-random-value
JWT_ISSUER=secure-service
JWT_TTL_MINUTES=60
